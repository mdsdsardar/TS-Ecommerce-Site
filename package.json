{
  "name": "ecommerce-site-ts",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "frontend": "npm run dev --workspace=frontend",
    "backend": "npm run dev --workspace=backend",
    "dev": "concurrently -k -n BACKEND,FRONTEND -c blue,green \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "uat": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspaces",
    "start": "npm run start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
